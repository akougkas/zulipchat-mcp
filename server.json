{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.PanStudio/zulipchat-mcp",
  "title": "ZulipChat MCP Server",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/PanStudio/zulipchat-mcp/main/docs/assets/zulipchat-mcp-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "description": "ZulipChat MCP: connect AI assistants to Zulip with a 13-tool core mode and 53-tool extended mode",
  "repository": {
    "url": "https://github.com/PanStudio/zulipchat-mcp",
    "source": "github"
  },
  "version": "0.8.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "zulipchat-mcp",
      "version": "0.8.3",
      "transport": {
        "type": "stdio"
      },
      "runtime": "python",
      "environmentVariables": [
        {
          "name": "ZULIP_EMAIL",
          "description": "Your Zulip account email address",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "ZULIP_API_KEY",
          "description": "Your Zulip API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "ZULIP_SITE",
          "description": "Your Zulip server URL (e.g., https://yourorg.zulipchat.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ],
      "arguments": [
        "--zulip-config-file",
        "~/.zuliprc"
      ]
    }
  ]
}
