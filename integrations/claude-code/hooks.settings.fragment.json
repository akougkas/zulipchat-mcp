{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "matcher": ".*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot",
                        "timeout": 900
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": ".*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "idle_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "matcher": ".*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ],
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "other|prompt_input_exit|logout",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx --from zulipchat-mcp==0.8.0 zulipchat-mcp-hook --zulip-config-file ~/.zuliprc --zulip-bot-config-file ~/.zuliprc-bot"
                    }
                ]
            }
        ]
    }
}
