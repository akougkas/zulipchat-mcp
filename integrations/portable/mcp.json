{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zulipchat": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "zulipchat-mcp",
        "--zulip-config-file",
        "/absolute/path/to/.zuliprc",
        "--extended-tools"
      ]
    }
  }
}
